{
  "name": "dsh-llm-agentrouter",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: the AgentRouter relay as one pi-ai route with a domestic/international endpoint switch in Settings, plus the outbound request compatibility the relay requires.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "llm",
    "agentrouter"
  ],
  "homepage": "https://github.com/aqiu817/dsh-llm-agentrouter#readme",
  "bugs": "https://github.com/aqiu817/dsh-llm-agentrouter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqiu817/dsh-llm-agentrouter.git"
  },
  "license": "MIT",
  "author": "aqiu817 (https://github.com/aqiu817)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "js-yaml": "4.1.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
